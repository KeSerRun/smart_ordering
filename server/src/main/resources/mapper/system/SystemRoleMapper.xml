<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.smartordering.modules.system.mapper.SysRoleMapper">

    <!-- 根据用户ID查询角色列表 -->
    <select id="selectRolesByUserId" resultType="com.smartordering.modules.system.entity.SysRole">
        SELECT r.*
        FROM sys_user_role ur
                 JOIN sys_role r ON ur.role_id = r.id
        WHERE ur.user_id = #{userId}
          AND r.deleted = 0
          AND r.status = 1
    </select>

</mapper>